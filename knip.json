{
  "$schema": "https://unpkg.com/knip@latest/schema.json",
  "entry": ["packages/*/src/index.ts", "tests/**/*.test.ts"],
  "project": ["**/*.{ts,tsx}"],
  "ignore": [
    "**/node_modules/**",
    "**/dist/**",
    "**/coverage/**",
    "**/.turbo/**"
  ],
  "ignoreDependencies": ["turbo"],
  "ignoreBinaries": ["husky", "Remove-Item"]
}
